@model Brand.Core.Components.UI.Icon.IconViewModel

@{
    var s = Model.Size.ToString();
}

@switch (Model.Name)
{
    case "arrow":
        <svg width="@s" height="@s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M4 12 H20 M14 6 L20 12 L14 18" />
        </svg>
        break;

    case "arrowdown":
        <svg width="@s" height="@s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M12 4 V20 M6 14 L12 20 L18 14" />
        </svg>
        break;

    case "menu":
        <svg width="@s" height="@s" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M2 5 H16 M2 9 H16 M2 13 H16" />
        </svg>
        break;

    case "close":
        <svg width="@s" height="@s" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M3 3 L15 15 M15 3 L3 15" />
        </svg>
        break;

    case "chevrondown":
        <svg width="@s" height="@s" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M3 6 L9 12 L15 6" />
        </svg>
        break;

    case "instagram":
        <svg width="@s" height="@s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="4" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
        </svg>
        break;

    case "facebook":
        <svg width="@s" height="@s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M15 4 H13 C11.5 4 11 5 11 6.5 V9 H8 V12 H11 V20 H14 V12 H17 L17.5 9 H14 V7 C14 6.4 14.4 6 15 6 H17 V4 Z" />
        </svg>
        break;

    case "tiktok":
        <svg width="@s" height="@s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M14 4 V14.5 C14 16.4 12.4 18 10.5 18 C8.6 18 7 16.4 7 14.5 C7 12.6 8.6 11 10.5 11" />
            <path d="M14 4 C14 6.2 15.8 8 18 8" />
        </svg>
        break;

    case "linkedin":
        <svg width="@s" height="@s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <path d="M7.5 10.5 V17 M7.5 7.2 V7.3" />
            <path d="M11.5 17 V13 C11.5 11.6 12.6 10.5 14 10.5 C15.4 10.5 16.5 11.6 16.5 13 V17" />
        </svg>
        break;

    case "youtube":
        <svg width="@s" height="@s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="2.5" y="6" width="19" height="12" rx="3.5" />
            <path d="M10.5 9.5 L15 12 L10.5 14.5 Z" />
        </svg>
        break;

    case "x":
        <svg width="@s" height="@s" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path d="M4 4 L20 20 M20 4 L4 20" />
        </svg>
        break;
}
